                                        TransactionHelper.EndCommand()
                                        WriteBlock.ExecuteTask(Step_Name, Task)
                                        TransactionHelper.BeginCommand("script")
                                        ### Check if the defeature result is acceptable. If not, undo the defeature step.
                                        fs_item=list(fs_sl_adj.Items)
                                        for i_fs in fs_item:
                                            if i_fs.IsDeleted==True:
                                                fs_sl_adj.Items.Remove(i_fs)                                
                                        ## For certain results, Undo what has been done by Custom_Fill.
                                        ## Adjacant faces missing/deleted, Adjacant face area change ratio is too much, Two adjacant faces are vertical: become not vertical after defeature
                                        if fs_sl_adj.Count<num_fs_adj:  ## Any of adjacant faces is missing/deleted.
                                            Custom_Undo(1)
        #                                if not newcreatedFaces==0:   ## If have new created faces after defeature, then Undo.
        #                                    Custom_Undo(1)
                                        elif fs_sl_adj.Count==num_fs_adj and num_fs_adj==2:
                                            aa1=fs_sl_adj.Items[0].Shape.Area
                                            aa2=fs_sl_adj.Items[1].Shape.Area
                                            v1=fs_sl_adj.Items[0].GetFaceNormal(0,0)
                                            v2=fs_sl_adj.Items[1].GetFaceNormal(0,0)
                                            dot_vv1vv2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                                            if abs(a1-aa1)/a1>Undo_fsACR_thread or abs(a2-aa2)/a2>Undo_fsACR_thread:    ## Face area changes over acceptable thread
                                                Custom_Undo(1)
                                            elif dot_v1v2==1.0 and not dot_vv1vv2==1.0:   ## v1.v2=1.0 meaning two faces are vertical
                                                Custom_Undo(1)
                                        else:
                                            pass
                                    #except:
                                        #print("Warning: had face defeature error...")
                                    if fs_sel.Items[0].IsDeleted==True:
                                        fs_sel_success=fs_sel_success+fs_sel
                                    else:
                                        fs_sel_fail=fs_sel_fail+fs_sel
                                elif str(type(fs.Shape.Geometry))=="<type 'Cone'>":
                                    fs_sel=Selection.Create(fs)                    
                                    fs_sel=Selection.Create(fs_sel.Items) #Transform Powerselection to selection
                                    fs_sel.SetActiveSecondary()
                                    #fs_sel.AddToActive()
                                    #try:
                                    fs_sl_checked=fs_sl_checked+fs_sel
                                    fs_sl_adj=fs_sel.ConvertToAdjacent()
                                    fs_item=list(fs_sl_adj.Items)
                                    for i_fs in fs_item:
                                        if i_fs in fs_sel.Items:
                                            fs_sl_adj.Items.Remove(i_fs)
                                    num_fs_adj=fs_sl_adj.Count
                                    if num_fs_adj<2:   # If free face, skip the defeature
                                        fs_sel_fe=fs_sel_fe+fs_sel
                                        continue
                                    Undo_check=True
                                    for ifs in fs_sl_adj.Items:
                                        if ifs.Shape.Area<Undo_fsA_thread:  # Just enable undo check/process for all the associated faces larger than a certain criteria
                                            Undo_check=False
                                            break
                                    if Undo_check==False:   # Do normal Fill without undo check/process
                                        try:
                                            result=Fill.Execute(fs_sel)
                                        except:
                                            print("Warning: had face defeature error...")                       
                                    elif Undo_check==True:   # Do normal Fill with undo check/process
                                        if num_fs_adj==2:
                                            a1=fs_sl_adj.Items[0].Shape.Area
                                            a2=fs_sl_adj.Items[1].Shape.Area
                                            v1=fs_sl_adj.Items[0].GetFaceNormal(0,0)
                                            v2=fs_sl_adj.Items[1].GetFaceNormal(0,0)
                                            dot_v1v2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                                        #result=Fill.Execute(fs_sel)
                                        #result=Custom_Fill()
                                        Task=NewTask(Custom_Fill)
                                        Step_Name = "Defeature"
                                        TransactionHelper.EndCommand()
                                        WriteBlock.ExecuteTask(Step_Name, Task)
                                        TransactionHelper.BeginCommand("script")
                                        ### Check if the defeature result is acceptable. If not, undo the defeature step.
                                        fs_item=list(fs_sl_adj.Items)
                                        for i_fs in fs_item:
                                            if i_fs.IsDeleted==True:
                                                fs_sl_adj.Items.Remove(i_fs)                                
                                        ## For certain results, Undo what has been done by Custom_Fill.
                                        ## Adjacant faces missing/deleted, Adjacant face area change ratio is too much, Two adjacant faces are vertical: become not vertical after defeature
                                        if fs_sl_adj.Count<num_fs_adj:  ## Any of adjacant faces is missing/deleted.
                                            Custom_Undo(1)
        #                                if not newcreatedFaces==0:   ## If have new created faces after defeature, then Undo.
        #                                    Custom_Undo(1)
                                        elif fs_sl_adj.Count==num_fs_adj and num_fs_adj==2:
                                            aa1=fs_sl_adj.Items[0].Shape.Area
                                            aa2=fs_sl_adj.Items[1].Shape.Area
                                            v1=fs_sl_adj.Items[0].GetFaceNormal(0,0)
                                            v2=fs_sl_adj.Items[1].GetFaceNormal(0,0)
                                            dot_vv1vv2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                                            if abs(a1-aa1)/a1>Undo_fsACR_thread or abs(a2-aa2)/a2>Undo_fsACR_thread:    ## Face area changes over acceptable thread
                                                Custom_Undo(1)
                                            elif dot_v1v2==1.0 and not dot_vv1vv2==1.0:   ## v1.v2=1.0 meaning two faces are vertical
                                                Custom_Undo(1)
                                        else:
                                            pass
                                    #except:
                                        #print("Warning: had face defeature error...")
                                    if fs_sel.Items[0].IsDeleted==True:
                                        fs_sel_success=fs_sel_success+fs_sel
                                    else:
                                        fs_sel_fail=fs_sel_fail+fs_sel
                                else:
                                    continue            

                msg="Actual time consuming for surfaces: "+str(time.time()-StartTime_fs)
                api.Application.ReportStatus(msg,api.StatusMessageType.Information,None)

            ###############################################
            ### Edge defeature execution process start    
            ###############################################
            edges_item_2=list(edges_defeature_sel.Items)
            for edge in edges_item_2:
                if edge.IsDeleted==True:
                    edges_defeature_sel.Items.Remove(edge)
            if Defeature_edge_exe==True and not edges_defeature_sel.Count==0:
                if IsACTMode==True and not fs_sel_fail.Count==0:   ### Create edge group again due to ACT bug which all actions done before failed faces would be Undo/Invalid
                    edge_grp=edges_defeature_sel.CreateAGroup(GrpNM_Index_DeftEdges+'_'+name_part)
                StartTime_edge=time.time()
                edge_exclude_sel=Selection.CreateByGroups(GrpNM_DONTDefeature).FilterEdges()
                edges_item=edges_defeature_sel.Items
                edges_item_2=list(edges_item)
                ## Remove the edges which were deleted or which are listed in 'Scr_DONT_DEFEATURE_GRP'
                for edge in edges_item_2:
                    if edge.IsDeleted==True or not edge_exclude_sel.Items.IndexOf(edge)==-1:
                        edges_defeature_sel.Items.Remove(edge)
                edges_item_2=list(edges_item)
                edges_grp_number=int(math.ceil(float(edges_item_2.Count)/maxdedgesatonce))
                temp_edges_list=[]
                edges_defeature_sel_list=[]
                for i in range(edges_grp_number):
                    if maxdedgesatonce*(i+1)>=edges_item_2.Count:
                        temp_edges_list.append(edges_item_2[(0+maxdedgesatonce*i):])
                    else:
                        temp_edges_list.append(edges_item_2[(0+maxdedgesatonce*i):(maxdedgesatonce*(i+1))])
                    edges_defeature_sel_list.append(Selection.Create(temp_edges_list[i]))
                ## Remove the edges which were deleted or which are listed in 'Scr_DONT_DEFEATURE_GRP'
                for i in range(edges_grp_number):
                    edges_item_2=list(temp_edges_list[i])
                    for edge in edges_item_2:
                        if edge.IsDeleted==True:
                            edges_defeature_sel.Items.Remove(edge)
                            edges_defeature_sel_list[i].Items.Remove(edge)
                    edges_defeature_sel_list[i].SetActive()
                    if not edges_defeature_sel_list[i].Count==0:
                        try:
                            Fill.Execute(edges_defeature_sel_list[i])
                            #XFillExecution(edges_defeature_sel_list[i], 10)
                            ### Below Delete is usually for the protected model.
                            #if not FindCircles(edges_defeature_sel_list[i],R_min_circle*2,R_max_circle*2,2,1).Count==0:
                                #Delete.Execute(edges_defeature_sel_list[i])
                        except:
                            msg="Warning: had edge defeature error..."
                            api.Application.ReportStatus(msg,api.StatusMessageType.Information,None)
                    ## Remove the deleted edges from list before 2nd defeature process
                    temp_edges_list[i]=edges_defeature_sel_list[i].Items
                    edges_item_2=list(temp_edges_list[i])
                    for edge in edges_item_2:
                        if edge.IsDeleted==True:
                            edges_defeature_sel.Items.Remove(edge)
                            edges_defeature_sel_list[i].Items.Remove(edge)
                    if not edges_defeature_sel_list[i].Count==0:
                        try:
                            Fill.Execute(edges_defeature_sel_list[i])
                            #XFillExecution(edges_defeature_sel_list[i], 10)
                        except:
                            msg="Warning: had edge defeature error..."
                            api.Application.ReportStatus(msg,api.StatusMessageType.Information,None)

                msg="Actual time consuming for edges: "+str(time.time()-StartTime_edge)
                api.Application.ReportStatus(msg,api.StatusMessageType.Information,None)

            ####################################################
            ### Apply new created Defeature function called "XFillExecution" at the last step
            ####################################################
            if Defeature_face_exe==True and XFill_Process==True:
                StartTime_fs=time.time()
                fs_item=fs_sel_defeature.Items
                fs_item_2=list(fs_item)
                ## Remove the faces which were deleted
                for fs in fs_item_2:
                    if fs.IsDeleted==True or not fs_exclude_sel.Items.IndexOf(fs)==-1:
                        fs_sel_defeature.Items.Remove(fs)
                fs_sel_defeature.SetActive()
                if not fs_sel_defeature.Count==0:
                    fs_xfill=Selection.Empty()
                    for fs_temp in fs_sel_defeature.Items:
                        if fs_temp in fs_sel_rf.Items:  #For reverse folding faces, do XFill with mode0
                            mode_XFill=0
                        elif fs_temp in fs_sel_fail.Items:  #For defeature failed faces, do XFill with mode1
                            mode_XFill=1
                        elif fs_temp in fs_sel_fe.Items:    # for those parts in fs_sel_fe, skip XFill.
                            continue
                        else:
                            continue    # Skip XFill.
                        fs_sel_temp=Selection.Create(fs_temp)
                        result=XFillExecution(fs_sel_temp,mode_XFill)
                        fs_xfill=fs_xfill+result
                    fs_item_2=list(fs_sel_defeature.Items)
                    for fs in fs_item_2:
                        if fs.IsDeleted==True:
                            fs_sel_defeature.Items.Remove(fs)
                    fs_sel_defeature=fs_sel_defeature+fs_xfill+Selection.Create(temp_DND_fs)   
                    if not fs_sel_defeature.Count==0:
                        if fs_grp.IsDeleted==False:
                            fs_grp.Delete() # Delete then re-create the same group name
                        fs_sel_defeature.SetActive()
                        fs_grp=fs_sel_defeature.CreateAGroup(GrpNM_Index_DeftFs+'_'+name_part)
                msg="Actual time consuming for surfaces(Unsuccessful Faces from Fill): "+str(time.time()-StartTime_fs)
                api.Application.ReportStatus(msg,api.StatusMessageType.Information,None)

        ### Consolidate defeature faces belong to the same parts into one NS
        ### Consolidate defeature edges belong to the same parts into one NS
        groups=api.Scripting.Commands.NamedSelection.GetGroups(api.Scripting.Helpers.DocumentHelper.GetRootPart())
        grp_Scr_fs_def=[]
        body_Scr_fs_def=[]
        grp_Scr_edges_def=[]
        body_Scr_edges_def=[]
        grp_ToBeDelete=[]
        for i_grp in groups:
            if not i_grp.Name.IndexOf(GrpNM_Index_DeftFs)==-1 and i_grp.Name.IndexOf(GrpNM_DeftFs_All)==-1:
                if not Selection.Create(i_grp.Members).FilterFaces().Count==0:
                    grp_Scr_fs_def.append(i_grp)
                    body_Scr_fs_def.append(i_grp.Members[0].Parent)
            elif not i_grp.Name.IndexOf(GrpNM_Index_DeftEdges)==-1 and i_grp.Name.IndexOf(GrpNM_DeftEdges_All)==-1:
                grp_Scr_edges_def.append(i_grp)
                body_Scr_edges_def.append(i_grp.Members[0].Parent)
        body_Scr_def_all=set(body_Scr_fs_def+body_Scr_edges_def)
        ## To organize the groups with collecting same body/part in one group
        for i_body in body_Scr_def_all:
            temp_part=i_body.GetMaster().Parent
            name_part=temp_part.Name+'_'+i_body.Name
            # Re-organize the groups with defeature faces
            temp_fs_sl=Selection.Empty()
            NS_name=GrpNM_Index_DeftFs+'_'+name_part      
            for i_grp in grp_Scr_fs_def:
                if i_grp.Members[0].Parent==i_body and not Selection.Create(i_grp.Members).FilterFaces().Count==0:
                    temp_fs_sl=temp_fs_sl+Selection.Create(i_grp.Members)
                    grp_ToBeDelete.append(i_grp)
            if not temp_fs_sl.Count==0:
                temp_fs_sl.CreateAGroup(NS_name)

            # Re-organize the groups with defeature edges
            temp_edges_sl=Selection.Empty()        
            NS_name=GrpNM_Index_DeftEdges+'_'+name_part      
            for i_grp in grp_Scr_edges_def:
                if i_grp.Members[0].Parent==i_body and not Selection.Create(i_grp.Members).FilterEdges().Count==0:
                    temp_edges_sl=temp_edges_sl+Selection.Create(i_grp.Members)
                    grp_ToBeDelete.append(i_grp)
            if not temp_edges_sl.Count==0:
                temp_edges_sl.CreateAGroup(NS_name)
        # To delete the duplicated groups that were created before re-organized
        for i_grp in grp_ToBeDelete:
            i_grp.Delete()

        ### Collect all defeature faces in one group
        ### Collect all defeature edges in one group
        groups=api.Scripting.Commands.NamedSelection.GetGroups(api.Scripting.Helpers.DocumentHelper.GetRootPart())
        fs_sizefilter_grp_name=GrpNM_DeftFs_All+'_GT'+(fs_grp_sizefilter*1e6).ToString()+'MM2'
        fs_smallfs_grp_name=GrpNM_DeftFs_All+'SmallSizeFaces'
        fs_def_sel=Selection.CreateByGroups(GrpNM_DeftFs_All)
        fs_def_sel_GTSize=Selection.Empty()
        fs_def_sel_GTSize_2=Selection.Empty()
        fs_def_sel_SmallSize=Selection.Empty()
        edges_def_sel=Selection.CreateByGroups(GrpNM_DeftEdges_All)
        for i_grp in groups:
            if not i_grp.Name.IndexOf(GrpNM_Index_DeftFs)==-1 and not Selection.Create(i_grp.Members).FilterFaces().Count==0:
                fs_def_sel=fs_def_sel+Selection.Create(i_grp.Members)
                i_grp.Delete()  # Don't need to keep the group for individual part
            elif not i_grp.Name.IndexOf(GrpNM_Index_DeftEdges)==-1 and not Selection.Create(i_grp.Members).FilterEdges().Count==0:
                edges_def_sel=edges_def_sel+Selection.Create(i_grp.Members)
                i_grp.Delete()  # Don't need to keep the group for individual part
        if not fs_def_sel.FilterFaces().Count==0:
            NamedSelection.Delete(GrpNM_DeftFs_All)
            fs_def_sel.CreateAGroup(GrpNM_DeftFs_All)
            for i_fs in fs_def_sel.Items:
                if i_fs.Shape.Area>fs_grp_sizefilter:
                    fs_def_sel_GTSize=fs_def_sel_GTSize+Selection.Create(i_fs)
            if not fs_def_sel_GTSize.Count==0:
                NamedSelection.Delete(fs_sizefilter_grp_name)
                fs_def_sel_GTSize.CreateAGroup(fs_sizefilter_grp_name)
            fs_def_sel_SmallSize=fs_def_sel-fs_def_sel_GTSize
            fs_def_sel_GTSize_2=fs_def_sel_GTSize_2+fs_def_sel_GTSize
            for ifs in fs_def_sel_SmallSize.Items:
                sl_adj=Selection.Create(ifs).ConvertToAdjacent()
                IsGoNext=True
                for jfs in sl_adj.Items:
                    if jfs in fs_def_sel_SmallSize.Items:
                        IsGoNext=False
                        break
                if IsGoNext==True:
                    temp_list=list(set(sl_adj.Items) & set(fs_def_sel_GTSize.Items))
                    min_area=None
                    fs_minA=None
                    for jfs in temp_list:
                        if min_area==None or jfs.Shape.Area<min_area:
                            min_area=jfs.Shape.Area
                            fs_minA=jfs
                    if not fs_minA==None:
                        fs_def_sel_GTSize_2=fs_def_sel_GTSize_2-Selection.Create(fs_minA)
            if not fs_def_sel_SmallSize.Count==0:
                NamedSelection.Delete(fs_smallfs_grp_name)
                fs_def_sel_SmallSize.CreateAGroup(fs_smallfs_grp_name)
            if not fs_def_sel_GTSize_2.Count==0:
                NamedSelection.Delete(fs_sizefilter_grp_name+'_2')
                fs_def_sel_GTSize_2.CreateAGroup(fs_sizefilter_grp_name+'_2')
        if not edges_def_sel.FilterEdges().Count==0:
            NamedSelection.Delete(GrpNM_DeftEdges_All)
            edges_def_sel.CreateAGroup(GrpNM_DeftEdges_All)


    msg = "Done, %.1f sec" % (time.time() - StartTime)
    try:
        api.Application.ReportStatus(msg, api.StatusMessageType.Information, None)
    except Exception:
        pass
    _safe_log_usage("SC_Defeature_func", "1.0", time.time() - StartTime, 1800)
    result["ok"] = "yes"
    result["message"] = msg
    result["elapsed_sec"] = "%.2f" % (time.time() - StartTime)

except Exception as exc:
    result["ok"] = "no"
    result["error"] = str(exc)
