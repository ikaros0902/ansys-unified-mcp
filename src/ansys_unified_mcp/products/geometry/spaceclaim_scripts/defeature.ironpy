# --- Helper Functions ---
def FindCircles(selection, D_min, D_max, Cmode=0, Fmode=1):
    '''
    :param selection: Find circles out of the selection
    :param D_min: min. diameter to find
    :param D_max: max. diameter to find
    :param Cmode: 0:Find the Full circle edges, 1:Find the Half circle edges, 2:Find circle smaller than half circle
    :param Fmode: 0:All circles without filtering, 1:For free-edge circles(defeature ans screw mounting purpose)
    :return: circle/edge list
  ''' 
    holes_list=[]
    #filter_circles_sel=Selection.Clear()
    edges_sel=selection.ConvertToEdges()
    ## Holes of Circle type
    circles_sel=edges_sel.ConvertByShape(api.Scripting.Selection.GeometryType.Circle)
    if circles_sel.Count!=0:
        filter_circles_sel=circles_sel.FilterByRadius(D_min/2,D_max/2)
        for edge in filter_circles_sel.Items:
            if Cmode==0: ## Full circle
                if edge.Shape.Length>2*3.14*(edge.Shape.Geometry.Radius): ## Curve is a full circle
                    holes_list.append(edge)
            elif Cmode==1:   ## Half circle
                if edge.Shape.Length<2*3.14*(edge.Shape.Geometry.Radius)*0.51 and edge.Shape.Length>2*3.14*(edge.Shape.Geometry.Radius)*0.49:
                    holes_list.append(edge)
            elif Cmode==2:   ## Smaller than half circle
                if edge.Shape.Length<2*3.14*(edge.Shape.Geometry.Radius)*0.5:
                    holes_list.append(edge)
    ## Holes of NurbsCurve/ProceduralCurve types
    nurbscurve_sel=ConvertEdgesByShape(edges_sel,api.Geometry.NurbsCurve)
    proceduralcurve_sel=ConvertEdgesByShape(edges_sel,api.Geometry.ProceduralCurve)
    sel=nurbscurve_sel+proceduralcurve_sel
    filter_curve=[]
    if sel.Count!=0:
        for i in sel.Items:
            length=i.Shape.Length
            pt1=i.Shape.StartPoint
            pt2=i.Shape.EndPoint
            dist_pt12=api.Scripting.Helpers.Gap.Create(pt1,pt2).Distance
            if not dist_pt12==0: ## not a full circle
                d=dist_pt12
            elif dist_pt12==0: ## a full circle
                d=length/3.1415926
            if d<=D_max and d>=D_min:
                if Cmode==0:  ## Full circle
                    if dist_pt12==0:
                        filter_curve.append(i)
                elif Cmode==1:   ## Half circle
                    if abs(length-2*3.14*d/2*0.5)/length<0.01:
                        filter_curve.append(i)
                elif Cmode==2:   ## Smaller than half circle
                    if length<2*3.14*d/2*0.5:
                        filter_curve.append(i)
    holes_list=holes_list+filter_curve
    ## Sort out the surface/face holes which are not the free edges
    holes_list_2=list(holes_list) ## Use list(holes_list)...holes_list_2 ID is different to holes_list ID
    for hole in holes_list_2:
        if hole.Parent.Shape.Volume==0:
            if not hole.Faces.Count==1 and Fmode==1:
                holes_list.remove(hole)
    return holes_list

### create a function for FaceType sorting
def ConvertFacesByShape(selection, ShapeType):
    """
    :param selection: FaceSelection to be used  for filtering faces based on their geometry type
    :param ShapeType: Shape types from object, api.Geometry
    :return: FaceSelection-if there is any face with specified shapetype, None-if none of the specified shape face
    
    Example usage:
    my_selection=Selection.Create(Face1,Face2,....,Face10)
    my_face_selection=my_selection.ConvertToFaces()
    my_shape_faces_selection=ConvertFacesByShape(my_face_selection,api.Geometry.ProceduralSurface)
  """
    item_list=[]
    if not selection.GetType()==api.Scripting.Selection.FaceSelection:
        return Selection.Empty()
    else:
        for item in selection.Items:
            if item.Shape.Geometry.GetType()==ShapeType:
                item_list.append(item)
        
    if len(item_list)==0:
        return Selection.Empty()
    else:
        _new_f_sel=api.Scripting.Selection.FaceSelection.Create(item_list)
        return _new_f_sel

def ConvertEdgesByShape(selection, ShapeType):
    """
    :param selection: Selection to be used  for filtering edges based on their geometry type
    :param ShapeType: Shape types from object, api.Geometry
    :return: EdgeSelection-if there is any edge with specified shapetype, None-if none of the specified shape edge
    
    Example usage:
    my_selection=Selection.Create(Edge1,Edge2,....,Edge10)
    my_edge_selection=my_selection.ConvertToFaces()
    my_shape_faces_selection=ConvertEdgesByShape(my_edge_selection,api.Geometry.NurbsCurve)
  """
    item_list=[]
    if not selection.GetType()==Selection and not selection.GetType()==api.Scripting.Selection.EdgeSelection and not selection.GetType()==api.Scripting.Selection.FaceSelection:
        return Selection.Empty()
    else:
        selection=selection.ConvertToEdges()
        for item in selection.Items:
            if item.Shape.Geometry.GetType()==ShapeType:
                item_list.append(item)
        
    if len(item_list)==0:
        return Selection.Empty()
    else:
        _new_f_sel=Selection.Create(item_list)
        return _new_f_sel

def XFillExecution(def_selection, def_mode):
    '''
    def_mode=0, defeature with Loft/Blend function
    def_mode=1, defeature with ExtrudeEdges fucntion
    def_mode=10, SpaceClaim Fill.Execute function
  '''
    if def_mode==10:
        def_result=Fill.Execute(def_selection)
        def_fs=def_result.CreatedFaces
    else:
        def_fs=[]
        def_result=None
        for fs in def_selection.Items:
            def_fs_sel=Selection.Create(fs)
            def_fs_sel.SetActiveSecondary()
            circle_list=FindCircles(def_fs_sel, 0, MM(1000), 1, 0)
            rdedge_list=FindCircles(def_fs_sel, 0, MM(1000), 2, 0)
            def_edges_sel=def_fs_sel.ConvertToEdges()
            def_edges_item_2=list(def_edges_sel.Items)
            if def_mode==0:  ### Loft/Blend
                try:
                    api.Scripting.Commands.Delete.Execute(def_fs_sel)
                    for i_edge in def_edges_item_2:
                        if i_edge.IsDeleted==True or i_edge in circle_list:
                            def_edges_sel.Items.Remove(i_edge)
                    if def_edges_sel.Count==3:
                        def_edges_item_2=list(def_edges_sel.Items)
                        for i_edge in def_edges_item_2:
                            intersect_pts=0
                            for j_edge in def_edges_item_2:
                                if not i_edge==j_edge:
                                    intersect_pts=intersect_pts+api.Scripting.Helpers.GeometryHelper.CurveCurveIntersect(i_edge,j_edge).NumberOfIntersections
                            if intersect_pts==2:
                                def_edges_sel.Items.Remove(i_edge)
                    def_edges_sel.SetActive()
                    # Create Blend
                    #selection = EdgeSelection.Create([GetRootPart().Components[70].Content.Bodies[0].Edges[2],GetRootPart().Components[70].Content.Bodies[4].Edges[4]])
                    options = api.Scripting.Commands.CommandOptions.LoftOptions()
                    options.GeometryCommandOptions = api.Scripting.Commands.CommandOptions.GeometryCommandOptions()
                    options.GeometryCommandOptions.KeepMirror = True
                    options.GeometryCommandOptions.KeepLayoutSurfaces = True
                    options.GeometryCommandOptions.KeepCompositeFaceRelationships = True
                    options.GeometryCommandOptions.Select = True
                    options.PeriodicBlend = False
                    options.RotationalBlend = False
                    options.SheetMetalBlend = False
                    options.ClockIt = False
                    options.IsRuled = False
                    options.IsLocalGuide = False
                    options.ExtrudeType = api.Scripting.Commands.CommandOptions.ExtrudeType.Add
                    def_result = api.Scripting.Commands.Loft.Create(def_edges_sel, None, options)
                    if not def_result.CreatedFaces.Count==0:
                        for def_i_fs in def_result.CreatedFaces:
                            def_fs.append(def_i_fs)
                except:
                    None
            elif def_mode==1:  ### ExtrudeEdges
                try:
                    for i_edge in def_edges_item_2:
                        if i_edge.IsDeleted==True:
                            def_edges_sel.Items.Remove(i_edge)
                        elif i_edge.Faces.Count==1:  # Free edge. It will be deleted after defeature face is deleted.
                            def_edges_sel.Items.Remove(i_edge)
                        elif not i_edge.Shape.Geometry.GetType()==api.Geometry.Line:
                            def_edges_sel.Items.Remove(i_edge)
                    if def_edges_sel.Count==2:
                        edge1=def_edges_sel.Items[0]
                        edge2=def_edges_sel.Items[1]
                        for i_face in edge1.Faces:
                            if not i_face==fs: face1=i_face
                        for i_face in edge2.Faces:
                            if not i_face==fs: face2=i_face
                        v1=face1.GetFaceNormal(0,0)
                        v2=face2.GetFaceNormal(0,0)
                        dot_v1v2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                        ### v1 dot v2=0 meaning 90/270 degree: two faces are 90/270 degree
                        ### For this XFill, limit to deal with 90/270 degree faces
                        if dot_v1v2==0 and api.Scripting.Helpers.GeometryHelper.CurveCurveIntersect(edge1,edge2).NumberOfIntersections==0:
                            api.Scripting.Commands.Delete.Execute(def_fs_sel)
                            def_edges_sel.SetActiveSecondary()
                            for i_edge in def_edges_sel.Items:
                                for j_edge in def_edges_sel.Items:
                                    if not i_edge==j_edge:
                                        selection=Selection.Create(i_edge)
                                        upToSelection=Selection.Create(j_edge.Faces[0])
                                        extrudedirection=upToSelection.Items[0].GetFaceNormal(0,0)
                                        pt=api.Geometry.Point.Create(MM(0), MM(0), MM(0))
                                        extrudetype=getattr(api.Scripting.Commands.CommandOptions.ExtrudeType, "None")
                                        def_result = api.Scripting.Commands.ExtrudeEdges.Execute(selection, extrudedirection, upToSelection, pt, extrudetype)
                                        if not def_result.CreatedFaces.Count==0:
                                            for def_i_fs in def_result.CreatedFaces:
                                                def_fs.append(def_i_fs)
                            # Delete failed face after new face is created. This is to avoid the original part was deleted and created new part instead.
                            # api.Scripting.Commands.Delete.Execute(def_fs_sel)
                except:
                    None
            else:
                None
    def_faces_sel=Selection.Create(def_fs)
    return def_faces_sel

def Custom_Fill():
    try:
        result=Fill.Execute(fs_sel)
    except:
        print("Warning: had face defeature error...")

def Custom_Undo(Num_Steps):
    TransactionHelper.EndCommand()
    api.Application.Undo(Num_Steps)
    TransactionHelper.BeginCommand("script")

def Custom_Redo(Num_Steps):
    TransactionHelper.EndCommand()
    api.Application.Redo(Num_Steps)
    TransactionHelper.BeginCommand("script")



### If the code is expired, would not execute main process.


# --- Main Execution ---
StartTime = time.time()

try:
    args = script_args
except NameError:
    try:
        args = Parameters
    except NameError:
        args = {}

try:
    if api is None:
        api, api_ver = _load_api()
        result["api"] = api_ver
        Selection = api.Scripting.Selection.Selection
        Fill = api.Scripting.Commands.Fill
        Delete = api.Scripting.Commands.Delete
        NamedSelection = api.Scripting.Commands.NamedSelection
        NewTask = api.Task
        WriteBlock = api.WriteBlock
        TransactionHelper = api.Scripting.Internal.TransactionHelper

    IsACTMode = False
    Defeature_face_exe = _b(args, "defeature_face_exe", True)
    Defeature_edge_exe = _b(args, "defeature_edge_exe", True)
    maxdedgesatonce = _i(args, "max_edges_at_once", 3000)
    R_max_cylinder = MM(_f(args, "r_max_cylinder", 3.5))
    R_min_circle = MM(_f(args, "r_min_circle", 0.0))
    R_max_circle = MM(_f(args, "r_max_circle", 3.5))
    fs_grp_sizefilter = MM2(_f(args, "fs_grp_sizefilter", 1.5))
    GrpNM_DONTDefeature = str(_arg(args, "grp_dont_defeature", "Scr_UserInput_DONT_DEFEATURE_GRP"))
    GrpNM_Index_DeftFs = str(_arg(args, "grp_index_deft_fs", "Scr_fs_def"))
    GrpNM_Index_DeftEdges = str(_arg(args, "grp_index_deft_edges", "Scr_edges_def"))
    GrpNM_DeftFs_All = str(_arg(args, "grp_deft_fs_all", "Scr_fs_def_ALL"))
    GrpNM_DeftEdges_All = str(_arg(args, "grp_deft_edges_all", "Scr_edges_def_ALL"))
    target_body_name = str(_arg(args, "target_body_name", ""))

    XFill_Process = True
    Undo_fsACR_thread = 0.7
    Undo_fsA_thread = MM2(300)

    # Determine selection or target body
    active_items = Selection.GetActive().Items
    if active_items.Count == 0:
        if target_body_name:
            all_b = Selection.SelectAll().ConvertToBodies().Items
            matched = [b for b in all_b if b.Name == target_body_name]
            if len(matched) > 0:
                body_sel = Selection.Create(matched[0])
            else:
                body_sel = Selection.SelectAll().ConvertToBodies()
        else:
            body_sel = Selection.SelectAll().ConvertToBodies()
    else:
        body_sel = Selection.GetActive()

    if body_sel.Count == 0:
        result["ok"] = "no"
        result["error"] = "No bodies found in active document to defeature"
    else:
        fs_exclude_sel = Selection.Empty()
        edge_exclude_sel=Selection.Empty()
        body_sel=Selection.Empty()
        body_sel=Selection.GetActive()

        ## Create "Scr_DONT_DEFEATURE_GRP" group if not yet create
        ## This is for edge and face defeature process.
        try:
            groups=api.Scripting.Commands.NamedSelection.GetGroups(api.Scripting.Helpers.DocumentHelper.GetRootPart())
        except:
            groups=[]
        checked_in_group=False
        for grp in groups:
            if grp.Name==GrpNM_DONTDefeature:
                checked_in_group=True
                break
        if checked_in_group==False:
            for edge_i in Selection.SelectAll().ConvertToEdges().Items:
                if edge_i.Shape.Geometry.GetType()==api.Geometry.Line:   #select a random line for creating new group purpose. Can't create new group with empty selection.
                    Selection.Create(edge_i).CreateAGroup(GrpNM_DONTDefeature)
                    break

        ## To check body qty and run defeature one body by one body
        for i_body in body_sel.ConvertToBodies().Items:        
            sel=Selection.Empty()
            for i_item in body_sel.Items: # Identify what items are belong to the same body
                if not i_item.IsDeleted:
                    if Selection.Create(i_item).ConvertToBodies().Items[0]==i_body:
                        sel=sel+Selection.Create(i_item)
            edges_sel=sel.ConvertToEdges()
            fs_sel=sel.ConvertToFaces()

            ## Collect all faces per face_type and radius range. Store in "fs_sel_defeature"
            sl=Selection.Empty()
            fs_sel_defeature=Selection.Empty()
            if not fs_sel.Count==0:
                face_type=[api.Geometry.Cylinder,api.Geometry.Torus,api.Geometry.Cone,api.Geometry.ProceduralSurface,api.Geometry.NurbsSurface]
                for i in face_type:
                    sl=sl+ConvertFacesByShape(fs_sel,i)
                    #fs_sel_cylinder=fs_sel.ConvertByShape(GeometryType.Cylinder)
                    #fs_sel_ProceduralSurface=ConvertFacesByShape(fs_sel,api.Geometry.ProceduralSurface)
                ## Filter faces per radius range
                ## For Nurbsface, still under working.
                for fs in sl.Items:
                    if str(type(fs.Shape.Geometry))=="<type 'Cylinder'>" and fs.Shape.Geometry.Radius<=R_max_cylinder and Selection.Create(fs).ConvertToEdges().Count!=2:
                        fs_sel_defeature=fs_sel_defeature+Selection.Create(fs)
                    elif str(type(fs.Shape.Geometry))=="<type 'Torus'>"and fs.Shape.Geometry.MinorRadius <=R_max_cylinder:
                        fs_sel_defeature=fs_sel_defeature+Selection.Create(fs)
                    elif str(type(fs.Shape.Geometry))=="<type 'Cone'>" or fs.Shape.Geometry.GetType()==api.Geometry.ProceduralSurface: # Haven't had good process to judge radius of Cone and Procedural surfaces
                        fs_sel_defeature=fs_sel_defeature+Selection.Create(fs)
                    elif fs.Shape.Geometry.GetType()==api.Geometry.NurbsSurface: # Haven't had good process to judge radius of Nurbsface surfaces
                        continue  #Temporarily do nothing...NurbsFace doesn't work well with Fill.execution
                        #fs_sel_defeature=fs_sel_defeature+Selection.Create(fs)
                    else:
                        continue

                ## Create a group to store the faces that are going to defeature
                if not fs_sel_defeature.Count==0:
                    temp_part=i_body.GetMaster().Parent
                    name_part=temp_part.Name+'_'+i_body.Name
                    NS_name=GrpNM_Index_DeftFs+'_'+name_part
                    fs_sel_defeature.SetActive()
                    #fs_grp=fs_sel_defeature.CreateAGroup("Face-Meshing_fs_defeature")           
                    fs_grp=fs_sel_defeature.CreateAGroup(NS_name)
                    #myNS=NamedSelection.Create(fs_sel_defeature,Selection())

            ## Collect all edges per radius min~max. Store in "edges_defeature_sel"
            edges_defeature_sel=Selection.Empty()
            if not edges_sel.Count==0:
                circles_list=FindCircles(edges_sel,R_min_circle*2,R_max_circle*2,2,1) # Edges per radius min~max
                filter_circles_sel=Selection.Create(circles_list)
                #if filter_circles_sel.Count!=0:
                    #filter_circles_sel.SetActive()  
                    #filter_circles_sel.CreateAGroup("filter_circles_sel")
                msg1=str(filter_circles_sel.Count)+" edges, "
                api.Application.ReportStatus(msg1,api.StatusMessageType.Information,None)
                #print (str(filter_circles_sel.Count)+" edges")
                ## To remove those edges connecting more than 1 face
                for edge in filter_circles_sel.Items:
                    # Check if the edge is belong to one face only
                    if edge.Faces.Count==1:
                        if edge.Shape.Geometry.GetType()==api.Geometry.Circle:    ## Circle edge is more normal case
                            if edge.Faces[0].Shape.Geometry.GetType()==api.Geometry.NurbsSurface or String(type(edge.Faces[0].Shape.Geometry))=="<type 'Cylinder'>" or String(type(edge.Faces[0].Shape.Geometry))=="<type 'Torus'>":
                                continue
                            else:
                                edg_sel=Selection.Create(edge)
                                edges_defeature_sel=edges_defeature_sel+edg_sel
                        elif not edge.Shape.Geometry.GetType()==api.Geometry.Circle: ## NurbsCurve happens in protected cad model...not easy to deal with
                            edges_adj_sel=Selection.Create(edge).ConvertToAdjacent()
                            fs_list=[]
                            for i_edge in edges_adj_sel.Items:
                                for i_fs in i_edge.Faces:
                                    if fs_list.IndexOf(i_fs)==-1:
                                        fs_list.append(i_fs)
                                        if len(fs_list)>1:
                                            break   # End the i_fs loop
                                if len(fs_list)>1:
                                    break   # End the i_edge loop
                            if len(fs_list)==1: #or <2
                                edg_sel=Selection.Create(edge)
                                #edg_sel.SetActive()
                                edges_defeature_sel=edges_defeature_sel+edg_sel
                # Create a group to store the edges that are going to defeature
                if not edges_defeature_sel.Count==0:
                    temp_part=i_body.GetMaster().Parent
                    name_part=temp_part.Name+'_'+i_body.Name
                    NS_name=GrpNM_Index_DeftEdges+'_'+name_part
                    edges_defeature_sel.SetActive()
                    #edge_grp=edges_defeature_sel.CreateAGroup("edges_defeature_sel")
                    edge_grp=edges_defeature_sel.CreateAGroup(NS_name)

            (edges_defeature_sel+fs_sel_defeature).SetActive()  # Show both founded edges and faces

            #############################################
            ### Run for Face defeature execution process
            #############################################
            fs_sel_success=Selection.Empty()
            fs_sel_fail=Selection.Empty()
            fs_sel_rf=Selection.Empty()
            fs_sel_fe=Selection.Empty() #fe=Free End
            if Defeature_face_exe==True and not fs_sel_defeature.Count==0:
                if IsACTMode==False:
                    StartTime_fs=time.time()
                    fs_exclude_sel=Selection.CreateByGroups(GrpNM_DONTDefeature).FilterFaces()
                    fs_item=fs_sel_defeature.Items
                    fs_item_2=list(fs_item)
                    temp_DND_fs=[]
                    ## Remove the faces which were deleted or which are listed in 'Scr_DONT_DEFEATURE_GRP'
                    for fs in fs_item_2:
                        if fs.IsDeleted==True:
                            fs_sel_defeature.Items.Remove(fs)
                        elif not fs_exclude_sel.Items.IndexOf(fs)==-1:
                            fs_sel_defeature.Items.Remove(fs)
                            temp_DND_fs.append(fs)
                    fs_sel_defeature.SetActive()
                    msg1=str(fs_sel_defeature.Count)+" surfaces, "
                    api.Application.ReportStatus(msg1,api.StatusMessageType.Information,None)
                    #print (str(fs_sel_defeature.Count)+" surfaces")

                    fs_sl_checked=Selection.Empty()
                    for fs in fs_sel_defeature.Items:
                        if fs.IsDeleted==False and not fs in fs_sl_checked.Items: # Check if this face was deleted due to prior defeature process.
                            # Selection.Create(fs).SetActive()
                            fs_sel_tmp=Selection.Create(fs)
                            half_circles=FindCircles(fs_sel_tmp,0,MM(1000),1,0) #Check if there is half-circle edge
                            if not half_circles.Count==0:    # half-circles=0 meaning it's not reverse folding face. If 180 reverse folding, skip it. Will handle this with XFill later.
                                if half_circles.Count==2:
                                    fs_adj=Selection.Create(half_circles).ConvertToFaces()-Selection.Create(fs)
                                    fs_allplane=False
                                    ## To check if circles' associated faces are all planes
                                    if not fs_adj.Count==0:
                                        for i_fs in fs_adj.Items:
                                            if i_fs.Shape.Geometry.GetType()==api.Geometry.Plane:
                                                fs_allplane=True
                                            else:
                                                fs_allplane=False
                                                break
                                    if fs_allplane==True:
                                        pass
                                    elif abs(half_circles[0].Shape.Length-half_circles[1].Shape.Length)/half_circles[0].Shape.Length>0.001:
                                        ### The two circle edges are with different length like U turn areas of embossment
                                        pass
                                    else:
                                        fs_sel_rf=fs_sel_rf+fs_sel_tmp  # Store reverse folding feature to defeature rf group
                                        continue
                            if str(type(fs.Shape.Geometry))=="<type 'Cylinder'>":
                                fs_rd_chn_sel=api.Scripting.PowerSelection.PowerSelection.Faces.ByRoundChain(Selection.Create(fs))
                                rd_chn=True
                                if fs_rd_chn_sel.Count==0:
                                    rd_chn=False
                                for fs_rd_chn in fs_rd_chn_sel.Items:
                                    if rd_chn==False:
                                        break
                                    if str(type(fs_rd_chn.Shape.Geometry))=="<type 'ProceduralSurface'>":
                                        continue
                                    for fs_check in fs_sel_defeature.Items:
                                        rd_chn=False
                                        if fs_rd_chn==fs_check:
                                            rd_chn=True
                                            break
                                if rd_chn==True:
                                    fs_sel=fs_rd_chn_sel
                                    fs_rd_chn_num=fs_rd_chn_sel.Count
                                elif rd_chn==False:
                                    fs_sel=Selection.Create(fs)                    
                                fs_sel=Selection.Create(fs_sel.Items) #Transform possible Powerselection to selection
                                fs_sel.SetActiveSecondary()
                                #fs_sel.AddToActive()
                                #try:
                                fs_sl_checked=fs_sl_checked+fs_sel
                                fs_sl_adj=fs_sel.ConvertToAdjacent()
                                fs_item=list(fs_sl_adj.Items)
                                for i_fs in fs_item:
                                    if i_fs in fs_sel.Items:
                                        fs_sl_adj.Items.Remove(i_fs)
                                num_fs_adj=fs_sl_adj.Count
                                if num_fs_adj<2:   # If free face, skip the defeature
                                    fs_sel_fe=fs_sel_fe+fs_sel
                                    continue
                                Undo_check=True
                                for ifs in fs_sl_adj.Items:
                                    if ifs.Shape.Area<Undo_fsA_thread:  # Just enable undo check/process for all the associated faces larger than a certain criteria
                                        Undo_check=False
                                        break
                                if Undo_check==False:   # Do normal Fill without undo check/process
                                    try:
                                        result=Fill.Execute(fs_sel)
                                    except:
                                        print("Warning: had face defeature error...")                       
                                elif Undo_check==True:   # Do normal Fill with undo check/process
                                    if num_fs_adj==2:
                                        a1=fs_sl_adj.Items[0].Shape.Area
                                        a2=fs_sl_adj.Items[1].Shape.Area
                                        v1=fs_sl_adj.Items[0].GetFaceNormal(0,0)
                                        v2=fs_sl_adj.Items[1].GetFaceNormal(0,0)
                                        dot_v1v2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                                    #result=Fill.Execute(fs_sel)
                                    #result=Custom_Fill()
                                    Task=NewTask(Custom_Fill)
                                    Step_Name = "Defeature"
                                    TransactionHelper.EndCommand()
                                    WriteBlock.ExecuteTask(Step_Name, Task)
                                    TransactionHelper.BeginCommand("script")
                                    ### Check if the defeature result is acceptable. If not, undo the defeature step.
                                    fs_item=list(fs_sl_adj.Items)
                                    for i_fs in fs_item:
                                        if i_fs.IsDeleted==True:
                                            fs_sl_adj.Items.Remove(i_fs)                                
                                    fs_remain=0
                                    for i_fs in fs_sel.Items:
                                        if not i_fs.IsDeleted==True:
                                            fs_remain=fs_remain+1
                                    ## For certain results, Undo what has been done by Custom_Fill.
                                    ## Adjacant faces missing/deleted, Adjacant face area change ratio is too much, Two adjacant faces are vertical: become not vertical after defeature
                                    if fs_sl_adj.Count<num_fs_adj:  ## Any of adjacant faces is missing/deleted.
                                        Custom_Undo(1)
        #                                if not newcreatedFaces==0:   ## If have new created faces after defeature, then Undo.
        #                                    Custom_Undo(1)
                                    elif fs_sl_adj.Count==num_fs_adj and num_fs_adj==2:
                                        aa1=fs_sl_adj.Items[0].Shape.Area
                                        aa2=fs_sl_adj.Items[1].Shape.Area
                                        v1=fs_sl_adj.Items[0].GetFaceNormal(0,0)
                                        v2=fs_sl_adj.Items[1].GetFaceNormal(0,0)
                                        dot_vv1vv2=abs(api.Geometry.Vector.Dot(v1.UnitVector,v2.UnitVector)/v1.UnitVector.Magnitude/v2.UnitVector.Magnitude)
                                        if abs(a1-aa1)/a1>Undo_fsACR_thread or abs(a2-aa2)/a2>Undo_fsACR_thread:    ## Face area changes over acceptable thread
                                            Custom_Undo(1)
                                        elif dot_v1v2==1.0 and not dot_vv1vv2==1.0:   ## v1.v2=1.0 meaning two faces are vertical
                                            Custom_Undo(1)
                                    elif rd_chn==True and not fs_remain==fs_rd_chn_num and not fs_remain==0:
                                        Custom_Undo(1)
                                    else:
                                        pass
                                #except:
                                    #print("Warning: had face defeature error...")
                                if fs_sel.Items[0].IsDeleted==True:
                                    fs_sel_success=fs_sel_success+fs_sel
                                else:
                                    fs_sel_fail=fs_sel_fail+fs_sel
                            elif str(type(fs.Shape.Geometry))=="<type 'Torus'>":
                                fs_rd_chn_sel=api.Scripting.PowerSelection.PowerSelection.Faces.ByRoundChain(Selection.Create(fs))
                                rd_chn=True
                                if fs_rd_chn_sel.Count==0:
                                    rd_chn=False
                                for fs_rd_chn in fs_rd_chn_sel.Items:
                                    if rd_chn==False:
                                        break
                                    #if String(type(fs_rd_chn.Shape.Geometry))=="<type 'ProceduralSurface'>":
                                        #continue
                                    for fs_check in fs_sel_defeature.Items:
