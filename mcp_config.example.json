{
  "mcpServers": {
    "ansys-unified-mcp": {
      "command": "C:/path/to/ansys-unified-mcp/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "ansys_unified_mcp"
      ],
      "cwd": "C:/path/to/ansys-unified-mcp",
      "env": {
        "PYTHONUTF8": "1",
        "ANSYS_MCP_PROFILE": "all"
      }
    }
  }
}
