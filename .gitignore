# 虛擬環境
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Python 快取與編譯檔案
__pycache__/
*.py[cod]
*$py.class
*.so

# 環境變數與設定
.env
.env.local
.env.*.local
.vscode/
.idea/

# 本機 IDE / Obsidian 設定
.kiro/settings/
.obsidian/
**/.obsidian/

# 執行日誌與暫存
*.log
*.txt
!requirements.txt
workbench_queue/*
!workbench_queue/.gitkeep
**/workbench_queue/*
!**/workbench_queue/.gitkeep

# Generated files & workbench journals
results/
mcp_config.json
status.json
!samples/
*.wbjn
!samples/*.wbjn
!src/ansys_unified_mcp/scripts/ansys_workbench_bridge.wbjn

# ANSYS documentation corpora — copyrighted + very large (~680 MB total).
Documentation/
Documentation_md/
Documentation_clean/
docs_index.sqlite

# CodeGraph index & Serena tooling cache
.codegraph/
.serena/

# Local run outputs & File-IPC command queue
runs/
src/**/tools/commands/
src/**/tools/results/
src/**/tools/runs/
src/**/tools/scripts/
src/**/tools/mcp.log
src/**/tools/status.json
