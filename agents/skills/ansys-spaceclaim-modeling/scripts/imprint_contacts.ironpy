# -*- coding: utf-8 -*-
# SpaceClaim server-side IronPython imprint and share topology script (ASCII only).
import sys
import time
import datetime

result = {}

def _load_api():
    import System
    loaded = []
    for asm in System.AppDomain.CurrentDomain.GetAssemblies():
        try:
            nm = asm.GetName().Name
        except Exception:
            continue
        if nm and nm.startswith("SpaceClaim.Api.V") and nm.count(".") == 2:
            loaded.append(nm.split(".")[-1])
    def _ver(v):
        try:
            return int(v[1:])
        except Exception:
            return 0
    names = sorted(set(loaded), key=_ver, reverse=True)
    names += ["V262", "V261", "V252", "V251", "V242", "V241", "V232", "V231", "V23", "V19"]
    import clr
    for ver in names:
        try:
            clr.AddReference("SpaceClaim.Api." + ver)
            clr.AddReference("SpaceClaim.Api." + ver + ".Scripting")
            import SpaceClaim.Api
            sc_api = getattr(SpaceClaim.Api, ver)
            clr.ImportExtensions(sc_api.Scripting.Extensions.DesignFaceExtensions)
            clr.ImportExtensions(sc_api.Scripting.Extensions.DesignEdgeExtensions)
            clr.ImportExtensions(sc_api.Scripting.Extensions.DesignBodyExtensions)
            clr.ImportExtensions(sc_api.Scripting.Extensions.ComponentExtensions)
            clr.ImportExtensions(sc_api.Scripting.Extensions.DocObjectExtensions)
            return sc_api, ver
        except Exception:
            continue
    raise RuntimeError("SpaceClaim API Reference Error: compatible version not found")

def _arg(d, k, default):
    try:
        if d.ContainsKey(k):
            return d[k]
    except Exception:
        try:
            return d[k]
        except Exception:
            pass
    return default

def _f(d, k, default):
    try:
        return float(_arg(d, k, default))
    except Exception:
        return float(default)

def _b(d, k, default):
    return str(_arg(d, k, "1" if default else "0")).lower() in ("1", "true", "yes")

def _safe_log_usage(act_name, act_version, elapsed_sec, manual_sec):
    try:
        import clr
        clr.AddReference("System")
        from System import Environment
        from System.IO import FileStream, StreamWriter, FileMode, FileAccess, FileShare, Directory
        user_name = Environment.UserName
        machine_name = Environment.MachineName
        timestamp = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        month = datetime.datetime.now().strftime("%Y_%m")
        log_dir = r"\\Twtrkei017\e\Structure_shared_folder\03. Team member\Ikaros\Test_ACT_usage_rate"
        if not Directory.Exists(log_dir):
            Directory.CreateDirectory(log_dir)
        log_path = log_dir + "\\usage_" + month + ".csv"
        saved_sec = manual_sec - elapsed_sec
        log_line = "{},{},{},{},{},{},{},{}\n".format(
            timestamp, user_name, machine_name,
            act_name, act_version,
            "%.1f" % elapsed_sec, manual_sec, "%.1f" % saved_sec
        )
        fs = FileStream(log_path, FileMode.Append, FileAccess.Write, FileShare.ReadWrite)
        writer = StreamWriter(fs)
        writer.Write(log_line)
        writer.Flush()
        writer.Close()
        fs.Close()
    except Exception:
        pass

StartTime = time.time()

try:
    args = script_args
except NameError:
    try:
        args = Parameters
    except NameError:
        args = {}

try:
    api, api_ver = _load_api()
    result["api"] = api_ver

    distance_range = _f(args, "distance_range_mm", 0.51)
    imprint_fun = _b(args, "imprint_curves", True)
    imprint_distance_range = _f(args, "imprint_distance_range_mm", 0.01)

    Selection = api.Scripting.Selection.Selection
    Commands = api.Scripting.Commands
    CommandOptions = Commands.CommandOptions

    # Imprint curves if requested
    imprint_count = 0
    if imprint_fun:
        try:
            opt = CommandOptions.FixImprintOptions()
            opt.Tolerance = MM(imprint_distance_range)
            opt.SearchFaces = True
            opt.SearchEdges = True
            opt.SearchCurves = True
            Commands.FixImprint.FindAndFix(opt)
            imprint_count += 1
        except Exception as e:
            result["imprint_warning"] = str(e)

    # Share Topology Named Selection
    try:
        st_opt = CommandOptions.ShareTopologyNamedSelectionOptions()
        st_opt.Tolerance = MM(distance_range)
        Commands.ShareTopologyNamedSelection.FindAndFix(st_opt)
    except Exception as e:
        result["share_topology_warning"] = str(e)

    elapsed = time.time() - StartTime
    _safe_log_usage("SC_Boned", "20230923", elapsed, 1800)

    result["ok"] = "yes"
    result["message"] = "Successfully executed imprint and share topology named selection"
    result["elapsed_sec"] = "%.2f" % elapsed

except Exception as exc:
    result["ok"] = "no"
    result["error"] = str(exc)
