#########################User Manual################################
#   1.selection a point where BGA will locate. if no selection, the default point is (0,0,0)
#   BGA_top/bottom: positive/nagative axis direction
#   BGA mating face=top/bottom meaning top/bottom face mating with selected point to locate
#
#############################Sub Function###################################                                          #20260410

def _find_extreme_face_by_Z(body, mode="max"):
    """
    mode = "max" -> ??Z ? ? face
    mode = "min" -> ??Z ? ? face
    """
    faces = list(body.Faces)
    if len(faces) == 0:
        raise Exception("No faces found on body.")

    if mode == "max":
        return max(faces, key=lambda f: _centerZ(f))
    elif mode == "min":
        return min(faces, key=lambda f: _centerZ(f))
    else:
        raise Exception("mode must be 'max' or 'min'")                                          #20260410

def _get_bbox(obj):
    try:
        return obj.Shape.GetBoundingBox(Matrix.Identity)
    except:
        try:
            return obj.GetBoundingBox(Matrix.Identity)
        except:
            try:
                return obj.GetBoundingBox()
            except:
                return None                                           #20260410

def _centerZ(obj):
    box = _get_bbox(obj)
    if box is None:
        return 0.0
    return (box.MinCorner.Z + box.MaxCorner.Z) / 2.0                                  #20260410
#########################Variable###################################
# BGA top: positive direction
# BGA bottom: nagative direction
#
BGA_dir = Direction.DirZ    #Direction.DirX / Direction.DirY
