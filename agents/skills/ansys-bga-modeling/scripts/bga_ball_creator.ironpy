BGA_offsetX=0 #[MM]
BGA_offsetY=0 #[MM]
BGA_offsetZ=0 #[MM]

BGA_UpToSelection = Selection.GetActive()

Initial_BGA_dir=Direction.DirZ
Total_h=BGA_h+low_pad_h+high_pad_h
