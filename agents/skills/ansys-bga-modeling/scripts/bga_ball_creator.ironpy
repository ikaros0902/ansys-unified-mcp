result = Move.Translate(selection, Initial_BGA_dir, MM(-(low_pad_h_mod+bot_solder_split*(Total_h_mod-low_pad_h_mod-high_pad_h_mod))), options, )
result = Move.Translate(selection, Initial_BGA_dir, MM(Total_h_mod-high_pad_h_mod-top_solder_split*(Total_h_mod-low_pad_h_mod-high_pad_h_mod)), options, )
# EndBlock

