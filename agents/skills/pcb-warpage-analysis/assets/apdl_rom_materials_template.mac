! ==========================================
! APDL Material Definitions (ROM Method) - TEMPLATE SKELETON
! PCB Multi-Layer Temperature-Dependent Materials
! Generated by: 02_calculate_rom_materials.py (Rule of Mixtures)
! E_eff(T)   = f_cu * E_cu(T)   + (1 - f_cu) * E_sub(T)
! CTE_eff(T) = f_cu * CTE_cu(T) + (1 - f_cu) * CTE_sub(T)
! NU_eff     = f_cu * NU_cu     + (1 - f_cu) * NU_sub
!
! PLACEHOLDER CONVENTION: <PLACEHOLDER> markers must be substituted by the
! generator script before this macro is read into MAPDL. Do not leave any
! <PLACEHOLDER> token in the final .mac file.
!
! CRITICAL APDL SYNTAX RULES (do not reorder):
!   1. MP, PRXY must be defined BEFORE MPTEMP / MPDATA commands for the same
!      material ID, otherwise MAPDL emits a deletion warning and drops data.
!   2. Temperature points must be listed in strictly ascending order.
!   3. Macro must end with FINISH followed by /SOLU to cleanly return MAPDL
!      to solver mode for the downstream Mechanical setup script.
! ==========================================

/PREP7
TREF, <INITIAL_TEMPERATURE_C>          ! Stress-free reference temperature (Ti), e.g. 30

! --- Layer <LAYER_ID> (<MATERIAL_TYPE>, Cu <CU_PERCENT>%) ---
! MATERIAL_TYPE example: EM-370 / EM-892K2 substrate laminate
! Define Poisson's ratio BEFORE MPTEMP / MPDATA to avoid deletion warning
MP, PRXY, <LAYER_ID>, <EFFECTIVE_POISSON_RATIO>

! Temperature points (23-point interpolation table split into 4 rows of <=6)
MPTEMP, 1, <T01>, <T02>, <T03>, <T04>, <T05>, <T06>
MPTEMP, 7, <T07>, <T08>, <T09>, <T10>, <T11>, <T12>
MPTEMP, 13, <T13>, <T14>, <T15>, <T16>, <T17>, <T18>
MPTEMP, 19, <T19>, <T20>, <T21>, <T22>, <T23>

! EX: Effective Young's Modulus (Pa) at each temperature point above
MPDATA, EX, <LAYER_ID>, 1, <E01>, <E02>, <E03>, <E04>, <E05>, <E06>
MPDATA, EX, <LAYER_ID>, 7, <E07>, <E08>, <E09>, <E10>, <E11>, <E12>
MPDATA, EX, <LAYER_ID>, 13, <E13>, <E14>, <E15>, <E16>, <E17>, <E18>
MPDATA, EX, <LAYER_ID>, 19, <E19>, <E20>, <E21>, <E22>, <E23>

! Re-declare temperature table before ALPX block (APDL requires MPTEMP
! immediately preceding each MPDATA property block)
MPTEMP, 1, <T01>, <T02>, <T03>, <T04>, <T05>, <T06>
MPTEMP, 7, <T07>, <T08>, <T09>, <T10>, <T11>, <T12>
MPTEMP, 13, <T13>, <T14>, <T15>, <T16>, <T17>, <T18>
MPTEMP, 19, <T19>, <T20>, <T21>, <T22>, <T23>

! ALPX: Effective Coefficient of Thermal Expansion (1/C) at each temperature point
MPDATA, ALPX, <LAYER_ID>, 1, <CTE01>, <CTE02>, <CTE03>, <CTE04>, <CTE05>, <CTE06>
MPDATA, ALPX, <LAYER_ID>, 7, <CTE07>, <CTE08>, <CTE09>, <CTE10>, <CTE11>, <CTE12>
MPDATA, ALPX, <LAYER_ID>, 13, <CTE13>, <CTE14>, <CTE15>, <CTE16>, <CTE17>, <CTE18>
MPDATA, ALPX, <LAYER_ID>, 19, <CTE19>, <CTE20>, <CTE21>, <CTE22>, <CTE23>

! --- Repeat the "Layer <LAYER_ID>" block above once per stackup layer ---
! --- (typical PCB stackup: up to 79 Solid Bodies / material IDs) ---

! Return MAPDL to solver mode after all material definitions are complete
FINISH
/SOLU
