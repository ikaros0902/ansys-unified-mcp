# ===== ANSYS Version Selector =====
# 切換目標 ANSYS 版本代號（例如 251 代表 2025 R1、242 代表 2024 R2、202 代表 2020 R2）。
# 系統會自動解析路徑為 ANSYS_ROOT\v<ANSYS_VERSION> 並推導各求解器路徑。
ANSYS_VERSION=<YOUR_ANSYS_VERSION_HERE>

# ANSYS 安裝父目錄（其下包含 v251、v242 等版本資料夾）
ANSYS_ROOT=C:\Program Files\ANSYS Inc

# ===== 專案與跨進程 IPC 佇列設定 =====
WORKBENCH_MCP_ROOT=C:\path\to\ansys-unified-mcp
# 跨進程通訊註冊表建議指向 LocalAppData（使獨立啟動的 ANSYS GUI 外掛與 MCP Server 共享同一狀態）
WORKBENCH_MCP_QUEUE_ROOT=C:\Users\<USERNAME>\AppData\Local\ansys-unified-mcp\queue
WORKBENCH_MCP_HOST=127.0.0.1
WORKBENCH_MCP_PORT=9885

# ===== 工具載入 Profile 模式 =====
# all: 載入全套 18 大物理領域工具（預設）
# core: 極簡核心診斷與 Meta-Router 模式（低 Token 消耗）
# mechanical / fluent / geometry / workbench / optislang: 僅載入特定單一學科工具
ANSYS_MCP_PROFILE=all

# ===== 工具剪枝開關 =====
# 設為 0 時僅暴露規範標準工具（約 216 個）；設為 1 時連同歷史別名一併暴露（約 279 個）
ANSYS_MCP_EXPOSE_ALIASES=0

# ===== ANSYS 官方手冊語料目錄 (選填) =====
# 留空：從 docs/ 讀取；若指向外部目錄，該目錄需包含 Documentation_md 與 Documentation_clean。
ANSYS_DOCS_ROOT=
