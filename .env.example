# ===== ANSYS Version Selector =====
# Change ONLY this line to switch versions (e.g. 251, 252, 261).
# config.py builds the root as ANSYS_ROOT\v<ANSYS_VERSION> and derives all
# executable paths from it. No need to hardcode per-exe paths below.
ANSYS_VERSION=<YOUR_ANSYS_VERSION_HERE>

# ANSYS installation parent directory (contains v251, v252, v261, ...)
ANSYS_ROOT=C:\Program Files\ANSYS Inc

# Unified MCP Server Settings
WORKBENCH_MCP_ROOT=C:\path\to\ansys-unified-mcp
WORKBENCH_MCP_QUEUE_ROOT=C:\path\to\ansys-unified-mcp\workbench_queue
WORKBENCH_MCP_HOST=127.0.0.1
WORKBENCH_MCP_PORT=9885

# ===== Optional explicit executable overrides =====
# Leave these commented out to let config.py derive them from ANSYS_VERSION.
# Only set them if your install uses a non-standard layout.
# ANSYS_RUNWB2=C:\Program Files\ANSYS Inc\v<VERSION>\Framework\bin\Win64\RunWB2.exe
# ANSYS_MECHANICAL=C:\Program Files\ANSYS Inc\v<VERSION>\aisol\bin\winx64\AnsysWBU.exe
# ANSYS_MAPDL=C:\Program Files\ANSYS Inc\v<VERSION>\ansys\bin\winx64\ANSYS.exe
# ANSYS_FLUENT=C:\Program Files\ANSYS Inc\v<VERSION>\fluent\ntbin\win64\fluent.exe
# ANSYS_CFX_SOLVE=C:\Program Files\ANSYS Inc\v<VERSION>\CFX\bin\cfx5solve.exe
# ANSYS_CFX_PRE=C:\Program Files\ANSYS Inc\v<VERSION>\CFX\bin\cfx5pre.exe
